    <h2 class="section-title"><span>Projects</span></h2>

    <div class="projects-grid">
      <!-- Project - ShopIQ -->
      <div class="glass-panel project-card">
        <h3>ShopIQ</h3>
        <p>AI-Powered Kirana Management System</p>
        <div class="project-tags">
          <span class="tag">React Native</span>
          <span class="tag">Expo</span>
          <span class="tag">Supabase</span>
          <span class="tag">FastAPI</span>
          <span class="tag">Gemini AI</span>
          <span class="tag">Prophet</span>
          <span class="tag">Whisper API</span>
        </div>
        <p>Full-stack mobile app for Indian kirana stores — AI demand forecasting, WhatsApp automation, voice input in Hindi &amp; Kannada, and profit analytics. Built at OkCredit Finternship.</p>
      </div>

      <!-- Project - PropagandaLens -->
      <div class="glass-panel project-card">
        <h3>PropagandaLens</h3>
        <p>Multilingual Propaganda & Manipulation Detector</p>
        <div class="project-tags">
          <span class="tag">Python</span>
          <span class="tag">FastAPI</span>
          <span class="tag">Groq AI</span>
          <span class="tag">Helsinki-NLP</span>
          <span class="tag">React</span>
        </div>
        <p>AI-powered tool detecting 8 rhetorical manipulation techniques in English & Hindi. Features temporal
          analysis, explainable AI chat, and PDF reports.</p>
        <a href="https://propaganda-lens.vercel.app/" target="_blank" class="project-link">
          Live Demo <i class="fas fa-external-link-alt" style="margin-left: 5px;"></i>
        </a>
      </div>

      <!-- Project 0 - UnMask -->
      <div class="glass-panel project-card">
        <h3>UnMask</h3>
        <p>AI Deepfake Detection System</p>
        <div class="project-tags">
          <span class="tag">TensorFlow</span>
          <span class="tag">EfficientNetB0</span>
          <span class="tag">Flask</span>
          <span class="tag">OpenCV</span>
          <span class="tag">MTCNN</span>
        </div>
        <p>Real-time deepfake detection for images &amp; videos using ensemble deep learning — built at FOOBAR 10.0
          Hackathon (Cybersecurity Domain).</p>
        <a href="https://unmask-nan8.onrender.com/" target="_blank" class="project-link">
          Live Demo <i class="fas fa-external-link-alt" style="margin-left: 5px;"></i>
        </a>
      </div>

      <!-- Project 1 removed -->

